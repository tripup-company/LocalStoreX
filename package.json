{
  "name": "localstorex",
  "private": true,
  "version": "2.0.0",
  "description": "A TypeScript wrapper around the browser's Web Storage adding per-item versioning and automatic expiration, with a choice of storage backend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tripup-company/LocalStoreX.git"
  },
  "homepage": "https://github.com/tripup-company/LocalStoreX#readme",
  "bugs": {
    "url": "https://github.com/tripup-company/LocalStoreX/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/localstorex.umd.cjs",
  "module": "./dist/localstorex.es.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/localstorex.es.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/localstorex.umd.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && node scripts/emit-cjs-types.mjs",
    "preview": "vite preview",
    "test": "jest"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-localstorage-mock": "^2.4.26",
    "ts-jest": "^29.2.5",
    "typescript": "~5.6.2",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.3.0"
  }
}
